# Local development. Copy to .env.local; never commit real values.
# Preview/staging must replace these with the hosted Supabase HTTPS URL,
# publishable key, and the stable canonical HTTPS staging URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
# APP_ENV is mandatory and explicit in hosted builds: preview, staging, or
# production. NODE_ENV=production never chooses one automatically.
PAYMENTS_MODE=disabled
STRIPE_CHECKOUT_MODE=disabled
# Required only when STRIPE_CHECKOUT_MODE=test. Test credentials only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only transactional notification testing with Inbucket/Mailpit.
NOTIFICATIONS_MODE=disabled
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@peter-golf.test
EMAIL_FROM_NAME=Peter Golf Pruebas
EMAIL_ALLOWED_RECIPIENT_DOMAINS=example.test,peter-golf.test

# Forbidden in Preview and whenever STRIPE_CHECKOUT_MODE=disabled:
# - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY
# - EMAIL_TRANSPORT, SMTP_*, EMAIL_FROM_*, EMAIL_ALLOWED_RECIPIENT_DOMAINS
# Preview must explicitly use APP_ENV=preview, PAYMENTS_MODE=disabled,
# STRIPE_CHECKOUT_MODE=disabled and NOTIFICATIONS_MODE=disabled.
# Staging Stripe test uses APP_ENV=staging, PAYMENTS_MODE=test,
# STRIPE_CHECKOUT_MODE=test, sk_test_*, whsec_* and its staging service role.
