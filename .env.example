# Local development. Copy to .env.local; never commit real values.
# Preview/staging must replace these with the hosted Supabase HTTPS URL,
# publishable key, and the stable canonical HTTPS staging URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
PAYMENTS_MODE=disabled

# Local-only transactional notification testing with Inbucket/Mailpit.
NOTIFICATIONS_MODE=disabled
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@peter-golf.test
EMAIL_FROM_NAME=Peter Golf Pruebas
EMAIL_ALLOWED_RECIPIENT_DOMAINS=example.test,peter-golf.test

# Forbidden in Preview/staging:
# - SUPABASE_SERVICE_ROLE_KEY (must remain unset; no administrative client)
# - EMAIL_TRANSPORT, SMTP_*, EMAIL_FROM_*, EMAIL_ALLOWED_RECIPIENT_DOMAINS
# Preview/staging must explicitly use PAYMENTS_MODE=disabled and
# NOTIFICATIONS_MODE=disabled.
