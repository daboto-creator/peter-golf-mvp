# Public project URL and anon/publishable key used by both Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intentionally empty in this phase. No administrative client is implemented.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
PAYMENTS_MODE=disabled

# Local/test transactional notifications. SMTP values are server-only.
NOTIFICATIONS_MODE=disabled
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@peter-golf.test
EMAIL_FROM_NAME=Peter Golf Pruebas
EMAIL_ALLOWED_RECIPIENT_DOMAINS=example.test,peter-golf.test
